plugins {
    id("com.android.application")
    id("org.jetbrains.kotlin.android")
    id("org.jetbrains.kotlin.plugin.compose")
}

dependencyLocking { lockAllConfigurations() }

// Version comes from the git tag in CI (-PversionName=1.2.3); local builds use 0.0.0-dev.
val versionNameProp = (findProperty("versionName") as String?) ?: "0.0.0-dev"
val versionCodeProp = (findProperty("versionCode") as String?)?.toInt() ?: 1

// Release signing from environment variables set by CI, supplied by reference; absent locally.
val keystorePath = System.getenv("{{signingPrefix}}_KEYSTORE")

android {
    namespace = "{{packageId}}"
    compileSdk = {{compileSdk}}

    defaultConfig {
        applicationId = "{{packageId}}"
        manifestPlaceholders["applicationName"] = "{{applicationName}}"
        minSdk = {{minSdk}}
        targetSdk = {{compileSdk}}
        versionCode = versionCodeProp
        versionName = versionNameProp
    }

    signingConfigs {
        if (keystorePath != null) {
            create("release") {
                storeFile = file(keystorePath)
                storePassword = System.getenv("{{signingPrefix}}_KEYSTORE_PASSWORD")
                keyAlias = System.getenv("{{signingPrefix}}_KEY_ALIAS")
                keyPassword = System.getenv("{{signingPrefix}}_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        release {
            isMinifyEnabled = false
            if (keystorePath != null) signingConfig = signingConfigs.getByName("release")
        }
    }

    buildFeatures {
        compose = true
        buildConfig = true
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    kotlin {
        jvmToolchain(17)
    }
{{componentSourceSets}}}

dependencies {
    val bom = platform("androidx.compose:compose-bom:2025.12.01")
    implementation(bom)
    implementation("androidx.compose.ui:ui")
    implementation("androidx.compose.material3:material3")
    implementation("androidx.activity:activity-compose:1.12.4")
    implementation("androidx.lifecycle:lifecycle-runtime-compose:2.10.0")
{{dependencies}}}
